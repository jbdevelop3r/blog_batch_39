<h1><%= @article.title %></h1>
<p><%= @article.body %></p>
<ul>
  <li><%= link_to "Edit", edit_article_path(@article) %></li>
  <li><%= link_to "Destroy", article_path(@article), data: {
                    turbo_method: :delete,
                    turbo_confirm: "Sure ka ba?"
                  } %></li>
</ul>
<br>
<%= link_to "See all comments", article_comments_path(@article) %>
<br>
<h2>Add a comment:</h2>
<%= render "comments/form" %>