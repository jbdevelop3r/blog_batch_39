<h2>Comments</h2>
<div>
  <% @comments.each do |hello_c| %>
    <div style="border: 1px solid black; padding: 10px">
      <p>Title: <%= hello_c.commenter %></p>
      <p>Body: <%= hello_c.body %></p>
      <p> <%= link_to "Show", article_comment_path(@article, hello_c) %> </p>
      <p> <%= link_to "Edit", edit_article_comment_path(@article, hello_c) %> </p>
    </div>
  <% end %>
</div>